{
  "name": "luranai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit --incremental false",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:push:dev": "prisma db push",
    "audit": "npm audit --omit=dev --audit-level=low",
    "check": "npm run test && npm run typecheck && npm run prisma:validate"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "next": "15.5.20",
    "openai": "^6.27.0",
    "postcss": "8.5.10",
    "prisma": "^5.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.2.1",
    "twilio": "^5.12.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
